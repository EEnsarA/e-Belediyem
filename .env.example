# Ortam Değişkenleri - Production'da değiştirin!

# PostgreSQL
POSTGRES_USER=belediye
POSTGRES_PASSWORD=belediye_pass_2024
POSTGRES_DB=akilli_belediye

# JWT
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production-min-32-chars

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# MinIO (S3 compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=complaints

# CORS
CORS_ORIGINS=http://localhost:3000

# Environment
ENVIRONMENT=development

# SMTP (haftalık brifing emaili için)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
